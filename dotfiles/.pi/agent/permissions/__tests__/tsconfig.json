{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@thurstonsand/pi-permissions": [
        "../../git/github.com/Rianico/pi-permissions/src/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "**/*.ts"
  ]
}
