{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@rianico/pi-permission-lsz": [
        "./node_modules/@rianico/pi-permission-lsz/src/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "**/*.ts"
  ]
}
