{
  "lastChangelogVersion": "1.3.0",
  "theme": "dracula",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4-flash",
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true
  },
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "compaction": {
    "enabled": true
  },
  "externalEditor": "nvim",
  "enabledModels": [
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/muse-spark-1.3-contributor",
    "clinepass/cline-pass/deepseek-v4.1-flash",
    "clinepass/cline-pass/muse-spark-1.3-contributor"
  ],
  "defaultThinkingLevel": "high",
  "packages": [
    {
      "source": "npm:pi-subagents",
      "prompts": []
    },
    "npm:@firstpick/pi-themes-bundle",
    "git:github.com/Rianico/pi-permission-lsz",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-btw",
    "git:github.com/Rianico/pi-better-edit",
    "npm:pi-lens",
    "git:github.com/Rianico/pi-editor-footer",
    "npm:pi-context-view"
  ],
  "fullscreenScrollbar": "auto",
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "editorPaddingX": 0,
  "markdown": {
    "mermaid": "final"
  },
  "retry": {
    "enabled": true
  },
  "enableSkillCommands": true,
  "fullscreenExitOutput": "transcript",
  "subagents": {
    "agentOverrides": {
      "worker": {
        "tools": "inherit",
        "inheritSkills": true,
        "inheritProjectContext": true
      }
    }
  },
  "npmCommand": [
    "pnpm"
  ],
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "+codemode"
  ],
  "outputPad": 1
}