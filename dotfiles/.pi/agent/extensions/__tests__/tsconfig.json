{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"types": [
			"node",
			"vitest/globals"
		]
	},
	"include": [
		"*.ts",
		"**/*.ts"
	]
}
